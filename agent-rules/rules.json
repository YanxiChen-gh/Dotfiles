{
  "rules": {
    "dotfiles-repo": {
      "body": "dotfiles-repo.md",
      "targets": {
        "cursor": {
          "file": "dotfiles-repo.mdc",
          "description": "The location of the user's personal Dotfiles repo. Apply when the user references \"my Dotfiles\" or \"the Dotfiles repo\".",
          "alwaysApply": false
        }
      }
    },
    "pr-authoring": {
      "body": "pr-authoring.md",
      "targets": {
        "cursor": {
          "file": "pr-authoring.mdc",
          "description": "Use the applicable authoring or review guide when writing code, PR feedback or technical documents.",
          "alwaysApply": true
        }
      }
    },
    "writing-style": {
      "body": "writing-style.md",
      "targets": {
        "cursor": {
          "file": "writing-style.mdc",
          "description": "Global output style: use plain hyphens, and keep code, tests, docs, and PR text focused on the final outcome rather than private drafting history.",
          "alwaysApply": true
        }
      }
    },
    "git-and-generated-files": {
      "body": "git-and-generated-files.md",
      "targets": {
        "cursor": {
          "file": "git-and-generated-files.mdc",
          "description": "Global git and file-editing rules: no agent co-author trailers, and never hand-edit generated files or CHANGELOG.md.",
          "alwaysApply": true
        }
      }
    },
    "autonomy": {
      "body": "autonomy.md",
      "targets": {
        "cursor": {
          "file": "autonomy.mdc",
          "description": "Defines when coding agents may inspect, edit, validate, commit, push, or expand scope.",
          "alwaysApply": true
        }
      }
    },
    "engineering-principles": {
      "body": "engineering-principles.md",
      "targets": {
        "cursor": {
          "file": "engineering-principles.mdc",
          "description": "Global engineering principles: decision priorities, reproduction-first bug fixing, UI pixel-perfection, and fixing lint/test/flaky issues you encounter.",
          "alwaysApply": true
        }
      }
    },
    "verification-and-handoff": {
      "body": "verification-and-handoff.md",
      "scope": "work",
      "comment": "Work PR handoff guidance.",
      "targets": {}
    },
    "local-dev-environment": {
      "body": "local-dev-environment.md",
      "scope": "work",
      "targets": {
        "cursor": {
          "file": "local-dev-environment.mdc",
          "description": "Local dev environment ops: provisioning worktrees and resolving local-server URLs through automatic SSH port forwarding, with explicit sharing fallbacks.",
          "alwaysApply": false
        }
      }
    },
    "mcp-preferences": {
      "body": "mcp-preferences.md",
      "scope": "work",
      "comment": "Codex-only: Cursor already carries the Glean bit via the hand-authored use-glean-mcp-for-google-docs.mdc.",
      "targets": {}
    },
    "vanta-work": {
      "body": "vanta-work.md",
      "scope": "work",
      "targets": {
        "cursor": {
          "file": "vanta-work.mdc",
          "description": "Standing approval and other personal agent behavior for Vanta work repositories.",
          "alwaysApply": true
        }
      }
    }
  },
  "codex": {
    "outputs": [
      {"file": "codex/AGENTS.md", "scope": "personal"},
      {"file": "codex/AGENTS-work.md", "scope": "work"}
    ],
    "title": "Codex Global Instructions",
    "rules": ["writing-style", "autonomy", "vanta-work", "engineering-principles", "git-and-generated-files", "pr-authoring", "verification-and-handoff"],
    "footer": "@RTK.md"
  },
  "claude": {
    "outputs": [
      {"file": "claude/CLAUDE.md", "scope": "personal"},
      {"file": "claude/CLAUDE-work.md", "scope": "work"}
    ],
    "title": "User-Level Claude Code Instructions",
    "rules": ["writing-style", "autonomy", "vanta-work", "engineering-principles", "git-and-generated-files", "pr-authoring", "verification-and-handoff"],
    "footer": "@RTK.md"
  },
  "opencode": {
    "outputs": [
      {"file": "opencode/AGENTS.md", "scope": "personal"},
      {"file": "opencode/AGENTS-work.md", "scope": "work"}
    ],
    "title": "OpenCode Global Instructions",
    "rules": ["writing-style", "mcp-preferences", "autonomy", "vanta-work", "engineering-principles", "git-and-generated-files", "pr-authoring", "verification-and-handoff"],
    "footer": ""
  }
}

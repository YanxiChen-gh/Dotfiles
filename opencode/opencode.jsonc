{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "compaction": {
    "prune": true
  },
  "command": {
    "checkpoint": {
      "description": "Checkpoint context and continue in the same session",
      "template": "A manual context checkpoint has been scheduled. Do not start or continue task work in this turn. Respond briefly that checkpointing is starting."
    },
    "canary-takeover": {
      "description": "Let a fresh successor perform one bounded unit of real local work",
      "template": "Load the canary-takeover skill and run one OpenCode live canary takeover. Follow its safety contract, evidence recording, and terminal audit exactly."
    }
  },
  "lsp": true,
  "plugin": ["opencode-claude-auth@1.5.4"],
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high"
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high"
    },
    "general": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high"
    },
    "explore": {
      "model": "openai/gpt-5.6-sol",
      "variant": "medium"
    }
  }
}
